root = true

# The repo is split between 2- and 4-space files (roughly src/card/ vs src/player/, though
# not cleanly). Nothing enforces either today; 4 is the majority. Match the file you're in
# rather than reformatting it - a whole-repo Prettier pass is a reasonable thing to do, but
# it should be its own commit so it doesn't bury real changes in reflowed whitespace.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{gradle,java}]
indent_size = 4

[*.{cs,xaml,csproj,appxmanifest}]
indent_size = 4
end_of_line = crlf
