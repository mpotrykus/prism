# Xbox UWP shell
xbox/PrismXbox/.vs/
xbox/PrismXbox/*.csproj.user
xbox/PrismXbox/bin/
xbox/PrismXbox/obj/
xbox/PrismXbox/AppPackages/
xbox/PrismXbox/BundleArtifacts/
xbox/PrismXbox/*.appx
xbox/PrismXbox/*.appxupload
xbox/PrismXbox/*.appxsym
# www/ is regenerated by `npm run xbox:sync` (vite build -> copy dist/*); don't track its
# contents, but keep the placeholder so a fresh clone has a valid Content root before the
# first sync.
xbox/PrismXbox/www/*
!xbox/PrismXbox/www/index.html

# Xbox video-effects Windows Runtime Component (see xbox/PrismXboxEffects/PrismXboxEffects.csproj's
# own header comment for why this is a separate project from PrismXbox). The compiled .cso shader
# bytecode under Shaders/ IS tracked (same precedent as moonlight-xbox's committed Assets/Shader/*.fxc)
# - only the usual build output is excluded here.
xbox/PrismXboxEffects/.vs/
xbox/PrismXboxEffects/*.csproj.user
xbox/PrismXboxEffects/bin/
xbox/PrismXboxEffects/obj/
