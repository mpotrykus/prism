# UWP shell (Xbox + PC, shared WebView2 host - see CLAUDE.md)
uwp/PrismUwp/.vs/
uwp/PrismUwp/*.csproj.user
uwp/PrismUwp/bin/
uwp/PrismUwp/obj/
uwp/PrismUwp/AppPackages/
uwp/PrismUwp/BundleArtifacts/
uwp/PrismUwp/*.appx
uwp/PrismUwp/*.appxupload
uwp/PrismUwp/*.appxsym
# www/ is regenerated by `npm run uwp:sync` (vite build -> copy dist/*); don't track its
# contents, but keep the placeholder so a fresh clone has a valid Content root before the
# first sync.
uwp/PrismUwp/www/*
!uwp/PrismUwp/www/index.html

# Video-effects Windows Runtime Component (see uwp/PrismUwpEffects/PrismUwpEffects.csproj's
# own header comment for why this is a separate project from PrismUwp). The compiled .cso shader
# bytecode under Shaders/ IS tracked (same precedent as moonlight-xbox's committed Assets/Shader/*.fxc)
# - only the usual build output is excluded here.
uwp/PrismUwpEffects/.vs/
uwp/PrismUwpEffects/*.csproj.user
uwp/PrismUwpEffects/bin/
uwp/PrismUwpEffects/obj/
