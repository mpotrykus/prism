{
  "name": "prism",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:set": "node scripts/set-version.mjs",
    "android": "vite build && node scripts/android-sync-shaders.mjs && npx cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "android:deploy": "node scripts/android-deploy.mjs",
    "android:bundle": "vite build && node scripts/android-sync-shaders.mjs && npx cap sync android && cd android && .\\gradlew.bat bundleRelease",
    "uwp:sync": "vite build && node scripts/uwp-sync.mjs",
    "xbox:build": "npm run uwp:sync && node scripts/xbox-build.mjs",
    "xbox:deploy": "node scripts/xbox-deploy.mjs",
    "xbox:deploy:debug": "node scripts/xbox-deploy.mjs --logs",
    "store:build": "npm run uwp:sync && node scripts/store-build.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "hls.js": "^1.6.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
