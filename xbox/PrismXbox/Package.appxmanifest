<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <Identity
    Name="com.mpotrykus.prismxbox"
    Publisher="CN=mpotrykus"
    Version="1.0.0.0" />

  <!--
    Empirically required, not just legacy cruft: a real MSBuild/APPX-packaging pass against
    this manifest (Visual Studio 2026's AppxPackage targets, Windows SDK 10.0.26100) fails with
    "APPX1673: App manifest is missing required element 'PhoneIdentity'" without this, even
    though this is a plain UWP app with no phone-specific behavior. Matches what Microsoft's
    own current Xbox WebView2 reference sample keeps in its manifest.
  -->
  <mp:PhoneIdentity PhoneProductId="a62934b7-8569-4975-b7bc-d573885807ed" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Prism</DisplayName>
    <PublisherDisplayName>mpotrykus</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!--
      Only Windows.Universal is declared here, not Windows.Xbox. This was verified against
      Microsoft's own current WebView2-on-Xbox reference sample
      (microsoft/Media-App-Samples-for-Xbox, WebView2/cs/JavaScriptVideoSample) - its manifest
      declares only Windows.Universal too. Xbox Dev Mode sideloads any Windows.Universal UWP
      package directly (Xbox is a child device family of Universal); a separate Windows.Xbox
      TargetDeviceFamily entry is not required for that path and isn't used by the reference
      sample. Add one only if/when this app is submitted to the Store specifically as an
      Xbox-targeted listing (deferred - see CLAUDE.md Phase 4 native player bridge / Store
      submission work).
    -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="PrismXbox.App">
      <uap:VisualElements
        DisplayName="Prism"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Prism - Plex browsing dashboard"
        BackgroundColor="#0a0a0c">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      Minimum required for the WebView2-hosted content to reach the network at all. Once the
      real app loads inside the WebView, it calls Plex/YouTube/OpenRouter directly from the
      client per CLAUDE.md's "no backend, no proxy" architecture invariant, so this capability
      is load-bearing beyond just the initial local-content navigation.
    -->
    <Capability Name="internetClient" />
    <!--
      Required for NATIVE code to reach a Plex server on the LAN. The WebView2-hosted web app
      does not need it - WebView2 runs its own network stack in a separate process, outside the
      app container's network isolation - which is why the browser leg has always worked against
      a private-network server with only internetClient declared.

      Native WinRT networking is inside the container, and without this it fails on any private
      address: AdaptiveMediaSource.CreateFromUriAsync returned ManifestDownloadFailure /
      0x80070005 (E_ACCESSDENIED) against https://192-168-0-224.<hash>.plex.direct:32400 while
      the same URL played fine in the WebView. Note plex.direct is a public DNS name that
      resolves to a private IP, so the isolation applies to the resolved address, not the name.
      moonlight-xbox declares this same capability for the same reason.
    -->
    <Capability Name="privateNetworkClientServer" />
    <!--
      hevcPlayback (the restricted capability that enables 4K/HDR10 playback per
      https://learn.microsoft.com/windows/uwp/audio-video-camera/hevc-xbox). A prior attempt
      declared this capability WITHOUT the xmlns:rescap namespace declaration/IgnorableNamespaces
      entry now above, and the app failed activation on the console with 0xc000027b
      (STATUS_STOWED_EXCEPTION), crashing before Microsoft.UI.Xaml.Markup.winmd had even loaded -
      i.e. before any first-party code in App or MainPage runs.

      moonlight-xbox (C++/CX, TargetDeviceFamily MinVersion 10.0.0.0) declares hevcPlayback the
      same way and works on this same console, and its manifest DOES declare xmlns:rescap - this
      build's previous attempt didn't. This is candidate #1 from the prior investigation. If this
      still crashes with 0xc000027b, remaining candidates: declaring a Windows.Xbox
      TargetDeviceFamily alongside Windows.Universal, or checking decode support at runtime via
      ProtectionCapabilities.IsTypeSupported instead - though that reports support rather than
      enabling the 4K path.

      PlayReady is not requested: nothing here plays DRM-protected content.
    -->
    <rescap:Capability Name="hevcPlayback" />
  </Capabilities>
</Package>
