<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <Identity
    Name="com.mpotrykus.prismxbox"
    Publisher="CN=mpotrykus"
    Version="1.0.0.0" />

  <!--
    Empirically required, not just legacy cruft: a real MSBuild/APPX-packaging pass against
    this manifest (Visual Studio 2026's AppxPackage targets, Windows SDK 10.0.26100) fails with
    "APPX1673: App manifest is missing required element 'PhoneIdentity'" without this, even
    though this is a plain UWP app with no phone-specific behavior. Matches what Microsoft's
    own current Xbox WebView2 reference sample keeps in its manifest.
  -->
  <mp:PhoneIdentity PhoneProductId="a62934b7-8569-4975-b7bc-d573885807ed" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Prism</DisplayName>
    <PublisherDisplayName>mpotrykus</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!--
      Only Windows.Universal is declared here, not Windows.Xbox. This was verified against
      Microsoft's own current WebView2-on-Xbox reference sample
      (microsoft/Media-App-Samples-for-Xbox, WebView2/cs/JavaScriptVideoSample) - its manifest
      declares only Windows.Universal too. Xbox Dev Mode sideloads any Windows.Universal UWP
      package directly (Xbox is a child device family of Universal); a separate Windows.Xbox
      TargetDeviceFamily entry is not required for that path and isn't used by the reference
      sample. Add one only if/when this app is submitted to the Store specifically as an
      Xbox-targeted listing (deferred - see CLAUDE.md Phase 4 native player bridge / Store
      submission work).
    -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="PrismXbox.App">
      <uap:VisualElements
        DisplayName="Prism"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Prism - Plex browsing dashboard"
        BackgroundColor="#0a0a0c">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      Minimum required for the WebView2-hosted content to reach the network at all. Once the
      real app loads inside the WebView, it calls Plex/YouTube/OpenRouter directly from the
      client per CLAUDE.md's "no backend, no proxy" architecture invariant, so this capability
      is load-bearing beyond just the initial local-content navigation.
    -->
    <Capability Name="internetClient" />
    <!--
      Not requested yet - this shell has no native player bridge (Phase 4, deferred). Add
      hevcPlayback / PlayReady DeviceCapability once MediaPlayerElement/HLS native playback
      is implemented; see https://learn.microsoft.com/windows/uwp/audio-video-camera/hevc-xbox
      and https://learn.microsoft.com/windows/uwp/audio-video-camera/playready-client-sdk
    -->
  </Capabilities>
</Package>
