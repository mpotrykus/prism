    <!--
      Wildcard include: the "www" folder is regenerated wholesale by the root repo's
      `npm run xbox:sync` script (vite build -> copy dist/* here), so its file list changes
      shape often. A per-file Content list here would go stale on every sync. Verify in
      Visual Studio that new files added under www/ after a sync are picked up automatically
      (Solution Explorer's "Show All Files" may be needed the first time) - classic UWP csproj
      Content globs build correctly via MSBuild either way, but VS's project-system display of
      glob-added items can lag until the project is reloaded.
    -->
    <Content Include="www\**\*.*" />
  </ItemGroup>
